<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
   
     http://www.springframework.org/schema/context/spring-context.xsd">

<!-- id means name of the object , class is required to get object -->
		
<!-- 		IOC creates object on basis of class attribute and fullyqualified name is mandatory
 -->		
      <!-- with the help of id value we can access bean object -->
 <bean id="message" class="java.lang.String">
 			<contructor-arg value ="Hello, how is Spring"/>
		</bean>
<!-- 		as the above tags create [ new String("Hello, how is Spring"); ]
 -->   
	<context:annotation-config/>

    <!-- Automatically scan for components/beans in your package path -->
    <context:component-scan base-package="com.ioc.beans"/>
	
    

</beans>